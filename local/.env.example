# LOCAL — server configuration. Copy to .env (never commit real values).
PORT=8787
# SQLite file path (durable, server-side). Use a persistent volume in production.
LOCAL_DB_PATH=./data/local.db
# Session signing secret. Required in production.
LOCAL_SESSION_SECRET=change-me
# First admin bootstrap (only used when the users table is empty).
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
# Anthropic Messages API for specialist agents (server-side only).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Explicit opt-in: allow uploaded/internal documents to be sent to the model provider.
LOCAL_ALLOW_INTERNAL_DOCS_TO_MODEL=false
# Optional connectors — leave blank to keep them in "credentials required".
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Outbound fetch controls
LOCAL_FETCH_USER_AGENT=LOCAL-research/0.1 (+contact: research-ops@example.com)
LOCAL_FETCH_MAX_PER_HOST_PER_MIN=20
# Set to 'true' to auto-seed the labeled demo workspace on first boot.
LOCAL_SEED_DEMO=true
