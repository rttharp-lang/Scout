{
  "name": "local-fandom-intelligence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LOCAL — NBA & WNBA fandom intelligence for Nike product management and design teams",
  "scripts": {
    "dev": "concurrently -k \"node server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "seed:demo": "node server/seed/cli.js demo",
    "test": "node --test tests/*.test.js",
    "smoke": "vite build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "playwright": "^1.61.1",
    "vite": "^5.4.11"
  }
}
